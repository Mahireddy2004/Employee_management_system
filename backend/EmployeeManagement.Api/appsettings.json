{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=employee_management;user=root;password=YOUR_MYSQL_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARS_LONG!",
    "Issuer": "EmployeeManagementApi",
    "Audience": "EmployeeManagementClient",
    "ExpiresInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "*",
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
