# Local Development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production Deployment:
# Option 1: Relative API path (recommended when using a reverse proxy or single-domain deployment)
# VITE_API_BASE_URL=/api
# Option 2: Full deployed HTTPS API URL (when frontend and backend are deployed to separate domains)
# VITE_API_BASE_URL=https://<your-backend-domain>/api
